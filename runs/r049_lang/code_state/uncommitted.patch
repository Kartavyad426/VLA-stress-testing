+def _with_masks(bo, src):
+    """A copy of backbone_output carrying the source's image and attention masks."""
+    import copy
+    out = copy.copy(bo)
+    for k in ("image_mask", "backbone_attention_mask"):
+        if k in src:
+            try:
+                out[k] = src[k]
+            except Exception:
+                setattr(out, k, src[k])
+    return out
