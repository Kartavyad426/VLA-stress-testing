# Virtualenvs — 8.7 GB, rebuildable from pinned versions in provenance.txt
.venvs/
.env

# Vendored upstream — clone at the SHA recorded in experiments/repro provenance
third_party/

__pycache__/
*.py[cod]

# Generated evidence. rollouts.jsonl is the source of truth for a run but grows
# without bound (LIBERO episodes carry full per-step obs_state); traces belong
# in object storage, not git. Manifests and provenance are kept — see below.
runs/**/rollouts.jsonl
experiments/repro/runs/**/*.log
experiments/repro/runs/**/videos/
runs/**/frames/
runs/**/*.png
# Per-episode video (~1-2 MB each, on by default since 2026-09-23), R-039 splice
# arrays and full run logs: regenerable or bulky, never tracked.
runs/**/video/
runs/**/splice/*.npz
runs/**/run.log


Screenshot from 2026-09-18 14-29-52.png

# Rollout traces: 830 MB across runs/ and never tracked (checked 2026-09-22:
# 0 of them in git). The small per-run metadata beside them IS tracked --
# arms.jsonl, cells.jsonl, report.json, adjudication.csv -- so this pins the
# existing convention rather than changing it, and stops a stray `git add -A`
# putting a 130 MB trace in the history permanently.
runs/**/rollouts.jsonl
runs/**/capture/

# Rendered review pages: each embeds its own replay video as base64, 1-11 MB
# apiece, ~500 MB total. Regenerate with experiments/visualise_episode_video.py
# or experiments/init_state_compare.py. The small level montages under
# viz/libero_plus_levels/ stay tracked.
viz/lplus_fail_groot/
viz/lplus_fail_minerva/
viz/lplus_failures/
viz/robot_initial_state_vs_canonical.html
viz/canonical_ramekin_initstate0.html
viz/episode_*_video.html
episode_video.html

# Generated activation / init-state review pages, 10-11 MB each (inherited from primary, 09-23)
viz/set_drawer_bowl_*.html
# R-058 r=64 backbone feature cache (34 GB); local only
runs/r058_r64_cache/

# D22 (10-07): raw LIBERO-Spatial demo HDF5s from HF yifengzhu-hf/LIBERO-datasets, 5.9 GB; checksums and
# verify.json beside them are small but live in the same dir, so the whole dir stays local
data/libero_raw/

# Third-party paper texts and code checkouts copied from res scratchpad (10-08, 716 KB); licences unchecked, kept local
docs/drafts/vla_corrector_sources/

# podolinsky GR00T-N1.7 LIBERO datasets (HF, gated, no licence stated; ~9.3 GiB+), internal use only, kept local (10-12)
data/podolinsky/

# Kept local (10-12): impl's r056fix smoke checkpoints (~440 MB) and the PoC toy's render videos
runs/impl_smoke/r056fix_v1/
runs/poc_toy/render/

# real2sim (res31, 10-14): large inputs and binary outputs stay local
data/real2sim/
runs/real2sim/**/*.mp4
runs/real2sim/**/*.npz
runs/real2sim/**/*.mjb
runs/real2sim/**/usd_*/
runs/real2sim/**/_*.png
